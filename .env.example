# ===== Umum =====
APP_ENV=development
TZ=UTC

# ===== Database =====
POSTGRES_USER=helmet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helmet_monitoring
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helmet:change-me@db:5432/helmet_monitoring

# ===== API / Auth =====
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# ===== Web =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
DISPLAY_TIMEZONE=Asia/Jakarta

# ===== Worker vision =====
VISION_BASE_URL=http://vision:8100   # API -> worker (proxy MJPEG, jaringan internal)
VISION_PORT=8100                     # port internal worker (tidak dipublish ke host)

# ===== Storage snapshot (privat, bukan folder publik) =====
STORAGE_DIR=/app/storage
SNAPSHOT_RETENTION_DAYS=30

# ===== Kredensial/URL stream kamera (JANGAN di-commit nilai aslinya) =====
# DB menyimpan nama variabel ini sebagai stream_config_ref + location teks bebas.
# HP: 1 HP sebagai hotspot (IP AP Android umumnya 192.168.43.1) + IP Webcam MJPEG.
# Webcam laptop (dev): CAM01_STREAM=0 dengan source_type=webcam di DB.
# Tambah CAM03 dst sesuai kebutuhan.
CAM01_STREAM=http://192.168.43.1:8080/video
CAM02_STREAM=http://192.168.43.101:8080/video

# ===== Model & inferensi =====
DETECTOR=fake                   # fake | yolo — fake untuk pengembangan tanpa model
MODEL_PATH=/app/ml/models/best.pt
MODEL_VERSION=helmet-v0.1
INFERENCE_DEVICE=cpu            # cpu | cuda:0
INFERENCE_IMGSZ=640
TARGET_FPS=10

# ===== Aturan kejadian (hipotesis awal, tentukan lewat eksperimen) =====
CONF_MIN=0.5
CONFIRM_N=3
CONFIRM_M=5
COOLDOWN_SECONDS=10
SNAPSHOT_RETRY_MAX=3

# ===== Reconnect kamera =====
RECONNECT_BACKOFF_INITIAL_SECONDS=1
RECONNECT_BACKOFF_MAX_SECONDS=30
